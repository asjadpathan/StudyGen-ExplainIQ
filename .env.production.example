# Production EC2 Environment (.env.production.example)
PORT=8000
USE_S3=true
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=studygen-media-assets
INTERNAL_API_SECRET=your_production_secure_secret_token
SPRING_BOOT_WEBHOOK_URL=https://studygen.in/api/internal/video-status
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
MAX_CONCURRENT_JOBS=2
