# ============================================================
# Explain IQ Video Generation Microservice — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.

# Google AI Studio API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for storyboard generation
# Options: gemini-flash-lite-latest (fast & high quota), gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest

# TTS voice (see: python -m edge_tts --list-voices)
TTS_VOICE=en-US-AriaNeural

# Video output settings
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24

# Pexels API key for real stock photos (optional, free at https://www.pexels.com/api/)
# If left blank, falls back to Wikimedia Commons API automatically (no key needed)
PEXELS_API_KEY=

# Concurrency & Worker settings (limit simultaneous encodes to prevent CPU saturation)
MAX_CONCURRENT_JOBS=2

# Directory paths
OUTPUT_DIR=./output
TEMP_DIR=./tmp

