# ============================================================
# Explain IQ Video Generation Microservice — Environment Config
# ============================================================
# Copy this file to .env or .env.local and fill in your values.

# ── Service & Network ───────────────────────────────────────
PORT=8000
INTERNAL_API_SECRET=studygen-internal-secret-token
SPRING_BOOT_WEBHOOK_URL=http://localhost:8080/api/internal/video-status

# ── Storage Configuration ───────────────────────────────────
# Set to false for local disk dev, or true to enable production AWS S3 uploads
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=studygen-media-assets

# ── Gemini Storyboarding Engine (Required) ──────────────────
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ── Voiceover & Subtitles (Edge-TTS) ────────────────────────
TTS_VOICE=en-US-AriaNeural

# ── Video Specs ─────────────────────────────────────────────
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24

# ── Stock Photos (Pexels / Wikimedia fallback) ─────────────
PEXELS_API_KEY=

# ── Concurrency & System Limits ─────────────────────────────
MAX_CONCURRENT_JOBS=2

# ── Directory Paths (optional overrides) ────────────────────
OUTPUT_DIR=./output
TEMP_DIR=./tmp
